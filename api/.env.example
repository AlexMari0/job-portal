# Copy to api/.env for local development.
PORT=8080

# Local MongoDB from docker-compose.yml (`make db`).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=job-portal

# Clerk webhook signing secret (Clerk dashboard → Webhooks → endpoint).
# Optional locally: without it POST /webhooks/clerk returns 503.
CLERK_WEBHOOK_SIGNING_SECRET=

# Clerk secret key (same Clerk app as the web). Without it the Candidate
# routes (/me, /me/applications, POST /jobs/{id}/applications) return 503.
CLERK_SECRET_KEY=
# Origin of the Next.js site; Clerk session tokens must be issued for it.
WEB_ORIGIN=http://localhost:3000

# Cloudinary (uploads). Without CLOUDINARY_CLOUD_NAME, upload routes return 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Signs Company session tokens (at least 32 random characters, e.g.
# `openssl rand -base64 48`). Without it Company sign-in returns 503.
COMPANY_JWT_SECRET=

# Sentry error reporting. Leave empty locally; set in staging/production.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Development alternative to Cloudinary: store uploads on disk and serve them
# at PUBLIC_URL/uploads/ (used only when CLOUDINARY_CLOUD_NAME is empty).
LOCAL_UPLOAD_DIR=
# This API's origin as browsers see it (default http://localhost:$PORT).
PUBLIC_URL=
