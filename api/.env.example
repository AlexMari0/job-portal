# Copy to api/.env for local development.
PORT=8080

# Local MongoDB from docker-compose.yml (`make db`).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=job-portal

# Clerk webhook signing secret (Clerk dashboard → Webhooks → endpoint).
# Optional locally: without it POST /webhooks/clerk returns 503.
CLERK_WEBHOOK_SIGNING_SECRET=
