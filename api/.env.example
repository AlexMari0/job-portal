# Copy to api/.env for local development.
PORT=8080

# Local MongoDB from docker-compose.yml (`make db`).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=job-portal

# Clerk webhook signing secret (Clerk dashboard → Webhooks → endpoint).
# Optional locally: without it POST /webhooks/clerk returns 503.
CLERK_WEBHOOK_SIGNING_SECRET=

# Clerk secret key (same Clerk app as the web). Without it the Candidate
# routes (/me, /me/applications, POST /jobs/{id}/applications) return 503.
CLERK_SECRET_KEY=
# Origin of the Next.js site; Clerk session tokens must be issued for it.
WEB_ORIGIN=http://localhost:3000

# Cloudinary (uploads). Without CLOUDINARY_CLOUD_NAME, upload routes return 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
