# Copy to web/.env.local for local development.

# Base URL of the Go API. Server-only (no NEXT_PUBLIC_ prefix).
API_URL=http://localhost:8080

# Clerk (Candidate sign-in). Use the development instance keys; the secret
# key is the same one the Go API uses.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Sentry error reporting (server and browser). Leave empty locally.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
